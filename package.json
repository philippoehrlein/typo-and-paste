{
  "name": "philippoehrlein/typo-and-paste",
  "type": "module",
  "version": "2.4.1",
  "private": true,
  "description": "A Kirby plugin for managing and inserting special characters with multi-language support.",
  "homepage": "https://github.com/philippoehrlein/typo-and-paste",
  "authors": [
    {
      "name": "Philipp Oehrlein",
      "email": "github@philippoehrlein.de"
    }
  ],
  "scripts": {
    "dev": "npx kirbyup serve src/index.js",
    "build": "npx kirbyup src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/**\" --write"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "autoprefixer": "^10.6.1",
    "kirbyup": "^3.5.0",
    "kirbyuse": "^1.4.0",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "js-yaml": "^4.3.2",
    "postcss-selector-parser": "^7.1.6",
    "vite": "^6.4.3"
  }
}
